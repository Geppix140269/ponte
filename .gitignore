# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups hold member personal data. Never commit them.
ponte-backups/
*.bundle
*.ndjson


# Build transcripts written during verification. Never part of the source.
build.log
build-verify.log
*.build.log


# Design mockups previewed locally. Never shipped.
*.local.html

# Playwright: browsers, traces and run output. Evidence PNGs are committed
# under docs/codex/audits/, but nothing generated at run time is.
/e2e/.playwright/

# The live-room manifest holds SESSION TOKENS for the two throwaway accounts the
# capture signs in as. `scripts/deal-room-live-room.mjs remove` deletes it along
# with the accounts; it must never reach a commit in the meantime.
/e2e/.deal-room-live.json
/playwright-report/
/test-results/

# Rendered email previews (fixtures only, regenerate with `npm run email:preview`)
.email-preview/
# Alternate Next build directories. The evidence run uses `.next-evidence`
# (see playwright.config.ts) and a diagnostic run may create another; none of
# them belongs in the repository. One accidentally reached a commit before this
# rule existed.
/.next-*/
